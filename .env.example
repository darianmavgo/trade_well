# trade_well local environment. Copy to .env (git-ignored) and fill in.
#
# LOCAL ONLY. This file is read by the backtest tools (market_history, ...) through
# pkg/backtest/appenv, from the project root: cwd, or bin/<cmd> -> the root above bin/.
#   * A real environment variable always wins over .env.
#   * Nothing deployed depends on it. App Engine never receives a .env (.gcloudignore ignores it,
#     a test enforces that) and the orchestrator ignores .env files when it runs on App Engine.
#   * The orchestrator and the schwaber CLI do not read it either: their configuration (Schwab
#     keys, STRATEGY_ALLOWLIST, SMTP, dashboard login, ...) is gs://<bucket>/config/env, edited
#     with deploy_gae/config.sh. Put those there, not here.

# Market data providers
POLYGON_API_KEY=
ALPACA_KEY=
ALPACA_SECRET=
# Alpaca trading endpoint (bars come from data.alpaca.markets, not this)
ALPACA_ENDPOINT=https://paper-api.alpaca.markets

# Project root for data/, refdata/ and reports (default: the current directory)
APP_FOLDER=
